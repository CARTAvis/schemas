{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Layout",
    "description": "Schema for CARTA Layout (Version 2)",
    "$id": "https://cartavis.org/schemas/layout_schema_2.json",
    "type": "object",
    "definitions": {
        "percentage-value": {
            "description": "Describes a percentage value from 0 to 100",
            "type": "number",
            "minimum": 0,
            "maximum": 100
        },
        "plot-type": {
            "description": "Describes a plot type",
            "enum": ["Steps", "Lines", "Points"]
        },
        "line-width": {
            "description": "Describes a plot line width",
            "type": "number",
            "minimum": 0.5,
            "maximum": 10.0
        },
        "point-size": {
            "description": "Describes a plot point size",
            "type": "number",
            "minimum": 0.5,
            "maximum": 10.0
        },
        "opacity": {
            "description": "Describes an opacity value between zero and one",
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "spatial-coord": {
            "description": "Spatial coordinate",
            "type": "string",
            "enum": ["x", "Ix", "Qx", "Ux", "Vx", "y", "Iy", "Qy", "Uy", "Vy"]
        },
        "basic-widget": {
            "type": "object",
            "description": "Widgets that have no associated settings",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "type": "string",
                    "enum": ["floating-settings", "layer-list", "log", "region-list", "image-view", "spectral-line-query", "cursor-info"]
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "catalog-overlay": {
            "type": "object",
            "description": "Catalog overlay widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "catalog-overlay"
                },
                "widgetSettings": {
                    "type": "object",
                    "description": "What belongs to the widget rather than to the catalog it shows. catalogFileId is retained for legacy layouts.",
                    "properties": {
                        "widgetId": {
                            "description": "Identifies this widget across the sessions a workspace spans",
                            "type": "string",
                            "minLength": 1
                        },
                        "catalogFileId": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "tableSeparatorPosition": {
                            "type": "string"
                        },
                        "headerTableColumnWidths": {
                            "description": "Widths of the header table's columns, in the fixed order the table lists them",
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "settingsTabId": {
                            "description": "The settings section this widget was left on, for whichever catalog it shows. A workspace keeps the section of each catalog in its catalogWidgets instead",
                            "type": "integer",
                            "minimum": 0
                        }
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "catalog-plot": {
            "type": "object",
            "description": "Catalog plot widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "catalog-plot"
                },
                "widgetSettings": {
                    "type": "object",
                    "description": "What survives any catalog. The catalog a plot shows and what it is drawn from are kept by a workspace, in its catalogWidgets",
                    "properties": {
                        "widgetId": {
                            "description": "Identifies this plot across the sessions a workspace spans",
                            "type": "string",
                            "minLength": 1
                        },
                        "plotType": {
                            "type": "string",
                            "enum": ["Image overlay", "Histogram", "2D scatter"]
                        },
                        "dragMode": {
                            "anyOf": [
                                {"type": "boolean", "const": false},
                                {"type": "string", "enum": ["zoom", "pan", "select", "lasso", "orbit", "turntable"]}
                            ]
                        },
                        "scatterBorder": {
                            "$ref": "#/definitions/catalog-scatter-border"
                        },
                        "histogramBorder": {
                            "$ref": "#/definitions/catalog-histogram-border"
                        }
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "spectral-profiler": {
            "type": "object",
            "description": "Spectral profiler widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "spectral-profiler"
                },
                "widgetSettings": {
                    "type": "object",
                    "properties": {
                        "widgetId": {
                            "description": "The widget's own ID, which stays the same across the sessions a layout is applied in",
                            "type": "string"
                        },
                        "primaryLineColor": {
                            "type": "string"
                        },
                        "lineWidth": {
                            "$ref": "#/definitions/line-width"
                        },
                        "linePlotPointSize": {
                            "$ref": "#/definitions/point-size"
                        },
                        "meanRmsVisible": {
                            "type": "boolean"
                        },
                        "plotType": {
                            "$ref": "#/definitions/plot-type"
                        },
                        "minXVal": {
                            "type": "number"
                        },
                        "maxXVal": {
                            "type": "number"
                        },
                        "minYVal": {
                            "type": "number"
                        },
                        "maxYVal": {
                            "type": "number"
                        },
                        "restFrameShiftMode": {
                            "type": "string",
                            "enum": ["redshift", "radial-velocity"]
                        },
                        "restFrameVelocityConvention": {
                            "type": "string",
                            "enum": ["radio", "optical", "relativistic"]
                        }
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "spatial-profiler": {
            "type": "object",
            "description": "Spatial profiler widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "spatial-profiler"
                },
                "widgetSettings": {
                    "type": "object",
                    "properties": {
                        "widgetId": {
                            "description": "The widget's own ID, which stays the same across the sessions a layout is applied in",
                            "type": "string"
                        },
                        "coordinate": {
                            "$ref": "#/definitions/spatial-coord"
                        },
                        "primaryLineColor": {
                            "type": "string"
                        },
                        "lineWidth": {
                            "$ref": "#/definitions/line-width"
                        },
                        "linePlotPointSize": {
                            "$ref": "#/definitions/point-size"
                        },
                        "wcsAxisVisible": {
                            "type": "boolean"
                        },
                        "meanRmsVisible": {
                            "type": "boolean"
                        },
                        "plotType": {
                            "$ref": "#/definitions/plot-type"
                        },
                        "minXVal": {
                            "type": "number"
                        },
                        "maxXVal": {
                            "type": "number"
                        },
                        "minYVal": {
                            "type": "number"
                        },
                        "maxYVal": {
                            "type": "number"
                        }
                    }
                },
                "coord": {
                    "description": "Legacy V1 entry (replaced by widgetSettings.coordinate",
                    "$ref": "#/definitions/spatial-coord"
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "render-config": {
            "type": "object",
            "description": "Render config widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "render-config"
                },
                "widgetSettings": {
                    "type": "object",
                    "properties": {
                        "widgetId": {
                            "description": "The widget's own ID, which stays the same across the sessions a layout is applied in",
                            "type": "string"
                        },
                        "primaryLineColor": {
                            "type": "string"
                        },
                        "lineWidth": {
                            "$ref": "#/definitions/line-width"
                        },
                        "linePlotPointSize": {
                            "$ref": "#/definitions/point-size"
                        },
                        "logScaleY": {
                            "type": "boolean"
                        },
                        "markerTextVisible": {
                            "type": "boolean"
                        },
                        "meanRmsVisible": {
                            "type": "boolean"
                        },
                        "plotType": {
                            "$ref": "#/definitions/plot-type"
                        },
                        "minXVal": {
                            "type": "number"
                        },
                        "maxXVal": {
                            "type": "number"
                        },
                        "minYVal": {
                            "type": "number"
                        },
                        "maxYVal": {
                            "type": "number"
                        }
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "histogram": {
            "type": "object",
            "description": "Histogram widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "histogram"
                },
                "widgetSettings": {
                    "type": "object",
                    "properties": {
                        "widgetId": {
                            "description": "The widget's own ID, which stays the same across the sessions a layout is applied in",
                            "type": "string"
                        },
                        "primaryLineColor": {
                            "type": "string"
                        },
                        "lineWidth": {
                            "$ref": "#/definitions/line-width"
                        },
                        "linePlotPointSize": {
                            "$ref": "#/definitions/point-size"
                        },
                        "logScaleY": {
                            "type": "boolean"
                        },
                        "meanRmsVisible": {
                            "type": "boolean"
                        },
                        "plotType": {
                            "$ref": "#/definitions/plot-type"
                        },
                        "minXVal": {
                            "type": "number"
                        },
                        "maxXVal": {
                            "type": "number"
                        },
                        "minYVal": {
                            "type": "number"
                        },
                        "maxYVal": {
                            "type": "number"
                        }
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "stokes": {
            "type": "object",
            "description": "Stokes analysis widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "stokes"
                },
                "widgetSettings": {
                    "type": "object",
                    "properties": {
                        "widgetId": {
                            "description": "The widget's own ID, which stays the same across the sessions a layout is applied in",
                            "type": "string"
                        },
                        "primaryLineColor": {
                            "type": "string"
                        },
                        "secondaryLineColor": {
                            "type": "string"
                        },
                        "lineWidth": {
                            "$ref": "#/definitions/line-width"
                        },
                        "linePlotPointSize": {
                            "$ref": "#/definitions/point-size"
                        },
                        "plotType": {
                            "$ref": "#/definitions/plot-type"
                        },
                        "colorMap": {
                            "type": "string"
                        },
                        "scatterPlotPointSize": {
                            "$ref": "#/definitions/point-size"
                        },
                        "pointTransparency": {
                            "$ref": "#/definitions/opacity"
                        },
                        "equalAxes": {
                            "type": "boolean"
                        }
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "catalog-scatter-border": {
            "type": "object",
            "required": ["xMin", "xMax", "yMin", "yMax"],
            "properties": {
                "xMin": {"type": "number"},
                "xMax": {"type": "number"},
                "yMin": {"type": "number"},
                "yMax": {"type": "number"}
            }
        },
        "catalog-histogram-border": {
            "type": "object",
            "required": ["xMin", "xMax"],
            "properties": {
                "xMin": {"type": "number"},
                "xMax": {"type": "number"}
            }
        },
        "stats": {
            "type": "object",
            "description": "Statistics widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "stats"
                },
                "widgetSettings": {
                    "type": "object",
                    "properties": {
                        "widgetId": {
                            "description": "The widget's own ID, which stays the same across the sessions a layout is applied in",
                            "type": "string"
                        }
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "animator": {
            "type": "object",
            "description": "Animator widgets",
            "required": ["type", "id"],
            "properties": {
                "type": {
                    "const": "component"
                },
                "id": {
                    "const": "animator"
                },
                "widgetSettings": {
                    "type": "object",
                    "properties": {
                        "timeLabelFormat": {
                            "type": "string",
                            "enum": ["auto", "iso", "mjd", "jd", "relative"]
                        },
                        "timeZoneMode": {
                            "type": "string",
                            "enum": ["utc", "local", "iana"]
                        },
                        "ianaTimeZone": {
                            "type": ["string", "null"]
                        },
                        "timeScale": {
                            "type": "string",
                            "enum": ["UTC", "TAI", "TT", "TCG"]
                        },
                        "isoTimePrecision": {
                            "type": "string",
                            "enum": ["auto", "year", "month", "day", "hour", "minute", "second", "millisecond", "microsecond"]
                        },
                        "numericTimePrecision": {
                            "type": ["integer", "null"],
                            "minimum": 0,
                            "maximum": 9
                        },
                        "relativeTimeReference": {
                            "type": "string",
                            "enum": ["first", "image", "custom"]
                        },
                        "relativeReferenceMjdUtc": {
                            "type": ["number", "null"]
                        },
                        "relativeTimeUnit": {
                            "type": "string",
                            "enum": ["auto", "second", "minute", "hour", "day", "year"]
                        }
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                }
            }
        },
        "carta-widget": {
            "description": "A CARTA widget",
            "oneOf": [
                {
                    "$ref": "#/definitions/basic-widget"
                },
                {
                    "$ref": "#/definitions/spectral-profiler"
                },
                {
                    "$ref": "#/definitions/spatial-profiler"
                },
                {
                    "$ref": "#/definitions/render-config"
                },
                {
                    "$ref": "#/definitions/histogram"
                },
                {
                    "$ref": "#/definitions/animator"
                },
                {
                    "$ref": "#/definitions/stats"
                },
                {
                    "$ref": "#/definitions/stokes"
                },
                {
                    "$ref": "#/definitions/catalog-overlay"
                },
                {
                    "$ref": "#/definitions/catalog-plot"
                }
            ]
        },
        "gl-container": {
            "description": "A GoldenLayout container",
            "type": "object",
            "required": ["type", "content"],
            "additionalProperties": false,
            "properties": {
                "type": {
                    "enum": ["row", "column", "stack"]
                },
                "content": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/definitions/gl-container"
                            },
                            {
                                "$ref": "#/definitions/carta-widget"
                            }
                        ]
                    }
                },
                "width": {
                    "$ref": "#/definitions/percentage-value"
                },
                "height": {
                    "$ref": "#/definitions/percentage-value"
                },
                "activeItemIndex": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        }
    },
    "required": ["layoutVersion", "docked", "floating"],
    "properties": {
        "layoutVersion": {
            "description": "The version of the layout contained",
            "type": "integer",
            "minimum": 1,
            "maximum": 2
        },
        "docked": {
            "description": "GoldenLayout widget hierarchy",
            "$ref": "#/definitions/gl-container"
        },
        "floating": {
            "description": "List of floating widgets",
            "type": "array",
            "items": {
                "allOf": [
                    {
                        "$ref": "#/definitions/carta-widget"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "defaultX": {
                                "type": "number"
                            },
                            "defaultY": {
                                "type": "number"
                            },
                            "defaultWidth": {
                                "type": "number"
                            },
                            "defaultHeight": {
                                "type": "number"
                            }
                        }
                    }
                ]
            }
        }
    }
}
